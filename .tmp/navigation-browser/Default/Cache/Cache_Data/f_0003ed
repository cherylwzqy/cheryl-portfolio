ary-link type-micro" href="/cheryl-portfolio/ux-service/"><span class="secondary-light" aria-hidden="true"></span><span class="secondary-label">← BACK TO UX / SERVICE</span></a><a class="secondary-link type-micro" href="/cheryl-portfolio/"><span class="secondary-light" aria-hidden="true"></span><span class="secondary-label">HOME</span></a></nav><div class="links2wellbeing-module___IA2YG__backgroundArcs" aria-hidden="true"><svg class="links2wellbeing-module___IA2YG__upperArc" viewBox="0 0 560 600" fill="none" focusable="false"><path d="M400 20A280 280 0 0 0 400 580"></path></svg><svg class="links2wellbeing-module___IA2YG__overviewArc" viewBox="0 0 560 600" fill="none" focusable="false"><path d="M160 20A280 280 0 0 1 160 580"></path></svg><svg class="links2wellbeing-module___IA2YG__lowerArc" viewBox="0 0 560 600" fill="none" focusable="false"><path d="M400 20A280 280 0 0 0 400 580"></path></svg><svg class="links2wellbeing-module___IA2YG__bottomArc" viewBox="0 0 560 600" fill="none" focusable="false"><path d="M160 20A280 280 0 0 1 160 580"></path></svg></div><div class="links2wellbeing-module___IA2YG__container"><section class="links2wellbeing-module___IA2YG__hero" aria-labelledby="project-title"><div class="links2wellbeing-module___IA2YG__heroCopy"><p class="links2wellbeing-module___IA2YG__eyebrow type-micro">SERVICE DESIGN / 2026</p><h1 id="project-title" class="links2wellbeing-module___IA2YG__title type-display">Links2Wellbeing</h1><p class="links2wellbeing-module___IA2YG__subtitle type-subtitle">Designing a Sustainable Knowledge Hub</p><p class="links2wellbeing-module___IA2YG__description type-body">Supporting Link Workers with easier access to resources, shared knowledge, and practical training.</p></div><div class="links2wellbeing-module___IA2YG__rings" aria-hidden="true"><svg viewBox="0 0 560 460" fill="none" focusable="false"><path class="links2wellbeing-module___IA2YG__connection" d="M0 200H70M490 200H560M280 425V460"></path><circle class="links2wellbeing-module___IA2YG__orangeRing" cx="215" cy="180" r="145" pathLength="1"></circle><circle class="links2wellbeing-module___IA2YG__roseRing" cx="345" cy="180" r="145" pathLength="1"></circle><circle class="links2wellbeing-module___IA2YG__tealRing" cx="280" cy="280" r="145" pathLength="1"></circle></svg></div></section><dl class="links2wellbeing-module___IA2YG__metadata" aria-label="Project details"><div><dt class="type-micro">PROJECT TYPE</dt><dd class="type-small"><ul role="list"><li>Service Design</li><li>Knowledge Sharing</li></ul></dd></div><div><dt class="type-micro">COLLABORATION</dt><dd class="type-small"><ul role="list"><li><a href="https://www.oacao.org/" target="_blank" rel="noopener noreferrer">OACAO</a></li><li><a href="https://www.oacao.org/programs/links2wellbeing/" target="_blank" rel="noopener noreferrer">Links2Wellbeing</a></li></ul></dd></div><div class="links2wellbeing-module___IA2YG__timeline"><dt class="type-micro">TIMELINE</dt><dd class="type-small"><ul role="list"><li>January – April 2026</li></ul></dd></div><div><dt class="type-micro">MY FOCUS</dt><dd class="type-small"><ul role="list"><li>Service Systems</li><li>Implementation Roadmap</li><li>Visualization</li></ul></dd></div></dl><section class="links2wellbeing-module___IA2YG__overview" aria-labelledby="overview-title"><div class="links2wellbeing-module___IA2YG__overviewLayout"><div class="links2wellbeing-module___IA2YG__overviewIdentity"><p id="overview-title" class="links2wellbeing-module___IA2YG__sectionLabel type-micro">01 / PROJECT OVERVIEW</p><div class="links2wellbeing-module___IA2YG__overviewLogos"><img alt="Older Adult Centres&#x27; Association of Ontario (OACAO) logo" loading="lazy" width="1280" height="536" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/OACAO_logo.jpg"/><img alt="Links2Wellbeing logo" loading="lazy" width="1400" height="530" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/L2W_logo.jpg"/></div></div><div class="links2wellbeing-module___IA2YG__overviewCopy type-body"><p>Links2Wellbeing is a social prescribing program supported by OACAO. Working with the project team, we explored how a shared Knowledge Hub could help Link Workers access resources, learn from one another, and maintain consistent service delivery.</p><p>Our proposal combined a digital Knowledge Hub with a broader support system, including service processes, future partnerships, and an implementation roadmap to support long-term sustainability.</p></div></div></section><section class="links2wellbeing-module___IA2YG__challenge" aria-labelledby="challenge-title"><div class="links2wellbeing-module___IA2YG__challengeLayout"><div class="links2wellbeing-module___IA2YG__challengeIntro"><p class="links2wellbeing-module___IA2YG__sectionLabel type-micro">02 / THE CHALLENGE</p><h2 id="challenge-title" class="links2wellbeing-module___IA2YG__challengeHeading type-h2">How can knowledge remain accessible, shared, and sustainable?</h2><p class="links2wellbeing-module___IA2YG__challengeDescription type-body">Links2Wellbeing relies on practical knowledge, accessible resources, and collaboration across service centres. Our challenge was to strengthen how this knowledge is organized, shared, and sustained over time.</p></div><ol class="links2wellbeing-module___IA2YG__challengeList"><li class="links2wellbeing-module___IA2YG__resourceChallenge"><span class="links2wellbeing-module___IA2YG__challengeNumber type-micro" aria-hidden="true">01</span><div><h3 class="type-subtitle">Dispersed Resources</h3><p class="type-body">Practical information and existing resources are spread across different places, making consistent onboarding and information finding more difficult.</p></div></li><li class="links2wellbeing-module___IA2YG__knowledgeChallenge"><span class="links2wellbeing-module___IA2YG__challengeNumber type-micro" aria-hidden="true">02</span><div><h3 class="type-subtitle">Knowledge Loss</h3><p class="type-body">Valuable experience often remains with individual staff members. Without a shared way to capture it, knowledge can be lost instead of passed between centres.</p></div></li><li class="links2wellbeing-module___IA2YG__sustainabilityChallenge"><span class="links2wellbeing-module___IA2YG__challengeNumber type-micro" aria-hidden="true">03</span><div><h3 class="type-subtitle">Sustainability</h3><p class="type-body">The service needs a foundation that can continue supporting Link Workers despite changes in funding and organizational resources.</p></div></li></ol></div><p class="links2wellbeing-module___IA2YG__designQuestion type-h2">How might we create a shared knowledge system that supports Link Workers today while remaining adaptable for the future?</p></section><section class="links2wellbeing-module___IA2YG__approach" aria-labelledby="approach-title"><p class="links2wellbeing-module___IA2YG__sectionLabel type-micro">03 / OUR APPROACH</p><h2 id="approach-title" class="links2wellbeing-module___IA2YG__approachHeading type-h2">From Challenges to Design Opportunities</h2><p class="links2wellbeing-module___IA2YG__approachIntroduction type-body">Our approach focused on three connected goals: making resources easier to access, supporting knowledge sharing among Link Workers, and building a foundation for long-term sustainability.</p><p style="margin:12px 0 0;position:relative;top:calc((clamp(40px, 5vw, 72px) - 12px) / 2);font-size:12px;font-weight:400;line-height:1.5;color:#929292;text-align:left">* Illustrations generated with OpenAI ImageGen</p><div class="links2wellbeing-module___IA2YG__approachColumns"><article class="links2wellbeing-module___IA2YG__resourcesApproach"><div class="links2wellbeing-module___IA2YG__approachIllustration"><img alt="Illustration of centralizing resources" loading="lazy" width="2860" height="2912" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/approach01.png"/></div><h3 class="type-subtitle">Centralize Resources</h3><p class="type-body">Bring scattered resources into one accessible place to simplify onboarding and everyday work.</p></article><article class="links2wellbeing-module___IA2YG__sharingApproach"><div class="links2wellbeing-module___IA2YG__approachIllustration"><img alt="Illustration of sharing knowledge among Link Workers" loading="lazy" width="1440" height="1456" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/approach02.png"/></div><h3 class="type-subtitle">Enable Knowledge Sharing</h3><p class="type-body">Create opportunities for Link Workers to exchange experiences, share practical knowledge, and learn from one another.</p></article><article class="links2wellbeing-module___IA2YG__sustainableApproach"><div class="links2wellbeing-module___IA2YG__approachIllustration"><img alt="Illustration of building a sustainable service foundation" loading="lazy" width="1452" height="1456" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/approach03.png"/></div><h3 class="type-subtitle">Build for Sustainability</h3><p class="type-body">Establish a foundation for future development through clear service processes, shared responsibilities, and ongoing support.</p></article></div></section><section class="links2wellbeing-module___IA2YG__knowledgeHub" aria-labelledby="knowledge-hub-title"><p class="links2wellbeing-module___IA2YG__sectionLabel type-micro">04 / KNOWLEDGE HUB</p><h2 id="knowledge-hub-title" class="links2wellbeing-module___IA2YG__hubHeading type-h2">A Shared Space for Knowledge and Collaboration</h2><p class="links2wellbeing-module___IA2YG__hubIntroduction type-body">We designed a centralized Knowledge Hub to help Link Workers easily find resources, connect with peers, and build their skills. The platform brings together practical tools, guidance materials, and community features to support their daily work and long-term professional growth.</p><div class="links2wellbeing-module___IA2YG__hubComposition"><div class="links2wellbeing-module___IA2YG__monitor"><div class="links2wellbeing-module___IA2YG__monitorScreen"><div class="links2wellbeing-module___IA2YG__screenContent"><img src="/cheryl-portfolio/images/L2W/knowledge%20hub.png" alt="Links2Wellbeing Knowledge Hub homepage" width="2559" height="1347" loading="eager"/><div class="links2wellbeing-module___IA2YG__screenAnnotations" aria-hidden="true"><svg viewBox="0 0 2559 1347" fill="none" focusable="false"><g class="links2wellbeing-module___IA2YG__resourceAnnotation"><path d="M-90 337H68"></path><circle cx="110" cy="337" r="42"></circle></g><g class="links2wellbeing-module___IA2YG__sharingAnnotation"><path d="M-90 913H68"></path><circle cx="110" cy="913" r="42"></circle></g><g class="links2wellbeing-module___IA2YG__learningAnnotation"><path d="M2270 760H2649"></path><circle cx="2220" cy="760" r="50"></circle></g></svg><span class="links2wellbeing-module___IA2YG__resourceMarker type-micro">01</span><span class="links2wellbeing-module___IA2YG__sharingMarker type-micro">02</span><span class="links2wellbeing-module___IA2YG__learningMarker type-micro">03</span></div></div></div><div class="links2wellbeing-module___IA2YG__monitorChin" aria-hidden="true"></div><div class="links2wellbeing-module___IA2YG__monitorStand" aria-hidden="true"></div><div class="links2wellbeing-module___IA2YG__monitorBase" aria-hidden="true"></div></div><h3 class="links2wellbeing-module___IA2YG__featureSubheading">HIGHLIGHT FEATURES</h3><div class="links2wellbeing-module___IA2YG__hubFeatures"><article class="links2wellbeing-module___IA2YG__libraryFeature"><span class="links2wellbeing-module___IA2YG__featureNumber type-micro">01 /</span><div class="links2wellbeing-module___IA2YG__featurePreview"><img alt="Resource Library interface preview" loading="lazy" width="390" height="357" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/resources.png"/></div><div><h3 class="type-subtitle">Resource Library</h3><p class="type-body">Find essential resources, templates, and guidance in one organized place.</p></div></article><article class="links2wellbeing-module___IA2YG__communityFeature"><span class="links2wellbeing-module___IA2YG__featureNumber type-micro">02 /</span><div class="links2wellbeing-module___IA2YG__featurePreview"><img alt="Knowledge Sharing community interface preview" loading="lazy" width="393" height="318" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/connect.png"/></div><div><h3 class="type-subtitle">Knowledge Sharing</h3><p class="type-body">Exchange experiences and learn from peers through community discussions and workshops.</p></div></article><article class="links2wellbeing-module___IA2YG__learningFeature"><span class="links2wellbeing-module___IA2YG__featureNumber type-micro">03 /</span><div class="links2wellbeing-module___IA2YG__featurePreview"><img alt="Onboarding and Learning tutorial interface preview" loading="lazy" width="548" height="540" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/tutorial.png"/></div><div><h3 class="type-subtitle">Onboarding &amp; Learning</h3><p class="type-body">Build confidence through guided onboarding and step-by-step learning resources.</p></div></article></div></div></section><section class="links2wellbeing-module___IA2YG__beyondPlatform" aria-labelledby="beyond-platform-title"><p class="links2wellbeing-module___IA2YG__sectionLabel type-micro">05 / BEYOND THE PLATFORM</p><h2 id="beyond-platform-title" class="links2wellbeing-module___IA2YG__beyondHeading type-h2">Designing the Service Behind the Experience</h2><p class="links2wellbeing-module___IA2YG__beyondIntroduction type-body">The Knowledge Hub is only one part of the solution. To support its long-term use, we also considered the people, processes, and partnerships needed to maintain the platform, support Link Workers, and keep knowledge accessible and up to date.</p><div class="links2wellbeing-module___IA2YG__blueprintRow"><button class="links2wellbeing-module___IA2YG__diagramPreview" type="button" aria-label="Enlarge Service Blueprint" aria-haspopup="dialog"><img alt="Service Blueprint" loading="lazy" width="10800" height="7200" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/blueprint.png"/></button><dialog class="links2wellbeing-module___IA2YG__diagramDialog" aria-label="Service Blueprint"><button class="links2wellbeing-module___IA2YG__diagramClose" type="button">Close</button><div class="links2wellbeing-module___IA2YG__diagramFullView"><img src="/cheryl-portfolio/images/L2W/blueprint.png" alt="Service Blueprint" width="10800" height="7200"/></div></dialog><div class="links2wellbeing-module___IA2YG__blueprintCopy"><h3 class="type-h2">Service Blueprint</h3><p class="type-body">This service blueprint shows how the Knowledge Hub works across different stages and highlights the roles and responsibilities of Link Workers, the OACAO team, partners, and supporting systems.</p></div></div><div class="links2wellbeing-module___IA2YG__ecosystemRow"><button class="links2wellbeing-module___IA2YG__diagramPreview" type="button" aria-label="Enlarge Future-State Network" aria-haspopup="dialog"><img alt="Future-State Network" loading="lazy" width="2466" height="1275" decoding="async" data-nimg="1" style="color:transparent" src="/cheryl-portfolio/images/L2W/futurestate.png"/></button><dialog class="links2wellbeing-module___IA2YG__diagramDialog" aria-label="Future-State Network"><button class="links2wellbeing-module___IA2YG__diagramClose" type="button">Close</button><div class="links2wellbeing-module___IA2YG__diagramFullView"><img src="/cheryl-portfolio/images/L2W/futurestate.png" alt="Future-State Network" width="2466" height="1275"/></div></dialog><div class="links2wellbeing-module___IA2YG__ecosystemCopy"><h3 class="type-h2">Supporting Ecosystem</h3><p class="type-body">The platform is supported by a network of stakeholders, including OACAO, Link Workers, SALCs, and other community partners. Together, they help maintain the Knowledge Hub, contribute resources, and support its long-term development.</p></div></div><div class="links2wellbeing-module___IA2YG__serviceConclusion"><svg viewBox="0 0 80 80" fill="none" aria-hidden="true" focusable="false"><path d="M40 68V38M40 48C20 48 12 35 14 19C31 18 40 29 40 48ZM40 38C40 22 51 12 68 14C68 29 57 40 40 38M25 31L40 48M55 25L40 38M25 68H55"></path></svg><div><h3 class="type-h2">Building a Sustainable Service</h3><p class="type-body">By aligning people, processes, and partnerships, we designed a service model that can be maintained, expanded, and adapted over time—helping the Knowledge Hub continue supporting Link Workers and communities across Ontario.</p></div></div></section><section class="links2wellbeing-module___IA2YG__sustainingService" aria-labelledby="sustaining-service-title"><p class="links2wellbeing-module___IA2YG__sectionLabel type-micro">06 / SUSTAINING THE SERVICE</p><h2 id="sustaining-service-title" class="links2wellbeing-module___IA2YG__sustainingHeading type-h2">From Pilot to Long-Term Sustainability</h2><p class="links2wellbeing-module___IA2YG__sustainingIntroduction type-body">We proposed a phased implementation strategy to help the Knowledge Hub grow gradually, adapt to the needs of Link Workers, and establish a sustainable support system beyond the initial project.</p><div class="links2wellbeing-module___IA2YG__roadmap"><div class="links2wellbeing-module___IA2YG__roadmapLine" aria-hidden="true"></div><ol class="links2wellbeing-module___IA2YG__roadmapPhases"><li class="links2wellbeing-module___IA2YG__pilotPhase"><span class="links2wellbeing-module___IA2YG__roadmapMilestone" aria-hidden="true"></span><div class="links2wellbeing-module___IA2YG__phaseContent"><p class="links2wellbeing-module___IA2YG__phaseLabel type-micro">PHASE 01 / PILOT</p><h3 class="type-subtitle">Test the Foundation</h3><p class="links2wellbeing-module___IA2YG__phaseDescription type-body">Audit existing resources, co-design with a small group of Link Workers, and test a simplified Knowledge Hub.</p><ul class="links2wellbeing-module___IA2YG__phaseActivities type-small"><li>Organize existing resources</li><li>Conduct small-scale co-design</li><li>Test onboarding and core features</li></ul></div></li><li class="links2wellbeing-module___IA2YG__growthPhase"><span class="links2wellbeing-module___IA2YG__roadmapMilestone" aria-hidden="true"></span><div class="links2wellbeing-module___IA2YG__phaseContent"><p class="links2wellbeing-module___IA2YG__phaseLabel type-micro">PHASE 02 / GROWTH</p><h3 class="type-subtitle">Expand and Organize</h3><p class="links2wellbeing-module___IA2YG__phaseDescription type-body">Introduce content governance, expand knowledge sharing, and integrate the Hub into training and daily workflows.</p><ul class="links2wellbeing-module___IA2YG__phaseActivities type-small"><li>Establish content ownership</li><li>Expand community participation</li><li>Integrate training and knowledge sharing</li></ul></div></li><li class="links2wellbeing-module___IA2YG__maturityPhase"><span class="links2wellbeing-module___IA2YG__roadmapMilestone" aria-hidden="true"></span><div class="links2wellbeing-module___IA2YG__phaseContent"><p class="links2wellbeing-module___IA2YG__phaseLabel type-micro">PHASE 03 / MATURITY</p><h3 class="type-subtitle">Sustain and Evolve</h3><p class="links2wellbeing-module___IA2YG__phaseDescription type-body">Develop advanced capabilities, strengthen reporting, and establish stable long-term ownership and support.</p><ul class="links2wellbeing-module___IA2YG__phaseActivities type-small"><li>Improve search and learning features</li><li>Strengthen reporting and evaluation</li><li>Secure long-term hosting and support</li></ul></div></li></ol></div><div class="links2wellbeing-module___IA2YG__sustainabilityConsiderations"><h3 class="type-subtitle">Key Considerations for Long-Term Sustainability</h3><div class="links2wellbeing-module___IA2YG__considerationGrid"><article><h4 class="type-subtitle">Service Ownership</h4><p class="type-body">Identify a long-term host organization or partner to support ongoing service delivery.</p></article><article><h4 class="type-subtitle">Content Maintenance</h4><p class="type-body">Establish clear responsibilities for reviewing, updating, and managing shared resources.</p></article><article><h4 class="type-subtitle">User Adoption</h4><p class="type-body">Support gradual onboarding and involve Link Workers in refining the service.</p></article><article><h4 class="type-subtitle">Funding &amp; Technical Support</h4><p class="type-body">Explore partnerships and existing infrastructure to reduce long-term operating costs.</p></article></div></div><section class="links2wellbeing-module___IA2YG__implementationPlan" aria-labelledby="implementation-plan-title"><p class="links2wellbeing-module___IA2YG__implementationLabel type-micro">IMPLEMENTATION PLAN</p><h3 id="implementation-plan-title" class="links2wellbeing-module___IA2YG__implementationHeading type-h2">Turning Strategy into Action</h3><p class="links2wellbeing-module___IA2YG__implementationDescription type-body">A practical implementation plan outlining the steps, responsibilities, and resources needed to move the service forward.</p><figure class="links2wellbeing-module___IA2YG__implementationFigure"><button class="links2wellbeing-module___IA2YG__diagramPreview" type="button" aria-label="Enlarge Links2Wellbeing implementation plan" aria-haspopup="dialog"><img src="/cheryl-portfolio/images/L2W/implementation-plan.png" alt="Links2Wellbeing implementation plan" width="10800" height="7200" loading="eager" style="display:block;width:100%;height:auto;opacity:1;visibility:visible;object-fit:contain"/></button><dialog class="links2wellbeing-module___IA2YG__diagramDialog" aria-label="Links2Wellbeing implementation plan"><button class="links2wellbeing-module___IA2YG__diagramClose" type="button">Close</button><div class="links2wellbeing-module___IA2YG__diagramFullView"><img src="/cheryl-portfolio/images/L2W/implementation-plan.png" alt="Links2Wellbeing implementation plan" width="10800" height="7200"/></div></dialog><figcaption class="links2wellbeing-module___IA2YG__implementationCaption type-small">Implementation Plan — Links2Wellbeing Service Design Project</figcaption></figure></section></section><section class="contribution-reflection-module__mhwxbW__section" aria-labelledby="contribution-reflection-title"><p class="contribution-reflection-module__mhwxbW__label type-micro">07 / MY CONTRIBUTION &amp; REFLECTION</p><h2 id="contribution-reflection-title" class="contribution-reflection-module__mhwxbW__heading type-h2">12 Weeks of Service Design</h2><p class="contribution-reflection-module__mhwxbW__introduction type-body">I was involved throughout the 12-week project, from initial research to final delivery. My contribution focused on research synthesis, service mapping, visualization, and implementation planning.</p><div class="contribution-reflection-module__mhwxbW__progression"><svg class="contribution-reflection-module__mhwxbW__timeline" viewBox="0 0 1000 220" fill="none" aria-hidden="true" focusable="false"><defs><linearGradient id="_R_9qnpfivb_-gradient" x1="0" y1="0" x2="1000" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--l2w-orange)"></stop><stop offset="33%" stop-color="var(--l2w-rose)"></stop><stop offset="66%" stop-color="var(--l2w-purple)"></stop><stop offset="100%" stop-color="var(--l2w-teal)"></stop></linearGradient><radialGradient id="_R_9qnpfivb_-glow"><stop stop-color="white" stop-opacity="0.9"></stop><stop offset="35%" stop-color="var(--l2w-teal)" stop-opacity="0.35"></stop><stop offset="100%" stop-color="var(--l2w-teal)" stop-opacity="0"></stop></radialGradient></defs><path id="_R_9qnpfivb_-path" class="contribution-reflection-module__mhwxbW__curve" d="M0 130C45 130 80 90 125 90